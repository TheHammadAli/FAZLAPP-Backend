model BroadcastMessage {
  id          Int             @id @default(autoincrement())
  broadcastId Int
  broadcast   Broadcast       @relation(fields: [broadcastId], references: [id])
  senderId    Int
  sender      User            @relation("BroadcastMessageSender", fields: [senderId], references: [id])
  receiverId  Int
  receiver    User            @relation("BroadcastMessageReceiver", fields: [receiverId], references: [id])
  threadId    Int
  thread      BroadcastThread @relation(fields: [threadId], references: [id])
  message     String?
  imageUrls   String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([broadcastId])
  @@index([threadId])
}
